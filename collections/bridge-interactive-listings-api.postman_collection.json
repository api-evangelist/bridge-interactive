          "name": "Query listings for a dataset",
          "request": {
            "name": "Query listings for a dataset",
            "description": {
              "content": "Returns normalized listing/property records for the given dataset. Supports field selection, sorting, geo (near) search, pagination, and per-field filter operators such as ListPrice.gt or City.eq.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":dataset_id",
                "listings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "Bridge access token. Optional when an Authorization Bearer header is supplied."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of records to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to include in each record."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "Field name to sort results by."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order."
                },
                {
                  "disabled": false,
                  "key": "near",
                  "value": "<string>",
                  "description": "Geographic point as \"longitude,latitude\" used for radius/near search."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataset_id",
                  "description": "(Required) The dataset identifier the request is scoped to."
                }
              ]
            },
            "header": [
